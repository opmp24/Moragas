{
  "$schema": "https://opencode.ai/config.json",
  "default_mode": "plan",
  "model": "opencode/deepseek-v4-flash-free",
  "project_name": "Moragas",
  "agents_config_path": "AGENTS.md",
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "tools": {
    "allow_global_exec": true,
    "allowed_commands": ["supabase", "npm", "npx", "git"]
  },
  "runtime": {
    "auto_verify_skills": true,
    "sandbox": false
  }
}
  